<Window x:Class="DentalClinicWPF.Views.Appointment.EditAppointmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Cita" Height="800" Width="800" WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Patient -->
                <Label Content="Paciente" Style="{StaticResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Patients}" 
                          DisplayMemberPath="DisplayInfo" 
                          SelectedValuePath="PatientID" 
                          SelectedValue="{Binding PatientID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                          Style="{StaticResource FormComboBoxStyle}" 
                          Margin="0,5" />

                <!-- Dentist -->
                <Label Content="Dentista" Style="{StaticResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Dentists}" 
                          DisplayMemberPath="DisplayInfo" 
                          SelectedValuePath="DentistID" 
                          SelectedValue="{Binding DentistID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                          Style="{StaticResource FormComboBoxStyle}" 
                          Margin="0,5" />

                <!-- Treatment -->
                <Label Content="Tratamiento" Style="{StaticResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Treatments}" 
                          DisplayMemberPath="DisplayInfo" 
                          SelectedValuePath="TreatmentID" 
                          SelectedValue="{Binding TreatmentID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                          Style="{StaticResource FormComboBoxStyle}" 
                          Margin="0,5" />

                <!-- Appointment Date -->
                <Label Content="Fecha de Cita" Style="{StaticResource FormLabelStyle}" />
                <DatePicker SelectedDate="{Binding AppointmentDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                            Style="{StaticResource FormDatePickerStyle}" 
                            Margin="0,5" />

                <!-- Start Time -->
                <Label Content="Hora de Inicio" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                         ToolTip="Formato: HH:mm" 
                         Style="{StaticResource FormTextBoxStyle}" 
                         Margin="0,5" />

                <!-- End Time -->
                <Label Content="Hora de Fin" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                         ToolTip="Formato: HH:mm" 
                         Style="{StaticResource FormTextBoxStyle}" 
                         Margin="0,5" />

                <!-- Notes -->
                <Label Content="Notas" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                         AcceptsReturn="True" 
                         Height="100" 
                         TextWrapping="Wrap" 
                         Style="{StaticResource FormTextBoxStyle}" 
                         Margin="0,5" />
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Danger}" Content="Eliminar" Command="{Binding DeleteCommand}" Width="100" Margin="5" />
        </StackPanel>
    </Grid>
</Window>

