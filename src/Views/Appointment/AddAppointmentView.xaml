<Window Width="900" Height="700" x:Class="DentalClinicWPF.Views.Appointment.AddAppointmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:DentalClinicWPF.ViewModels.Appointment" Title="Agregar Cita" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}"    >
    
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Input Fields -->
    
      <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <!-- Patient -->
        <Label Content="Paciente" Style="{StaticResource FormLabelStyle}" />
        <ComboBox ItemsSource="{Binding Patients}" DisplayMemberPath="DisplayInfo" SelectedValuePath="PatientID" SelectedValue="{Binding PatientID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormComboBoxStyle}" />
        <!-- Dentist -->
        <Label Content="Dentista" Style="{StaticResource FormLabelStyle}" />
        <ComboBox ItemsSource="{Binding Dentists}" DisplayMemberPath="DisplayInfo" SelectedValuePath="DentistID" SelectedValue="{Binding DentistID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormComboBoxStyle}" />
        <!-- Treatment -->
        <Label Content="Tratamiento" Style="{StaticResource FormLabelStyle}" />
        <ComboBox ItemsSource="{Binding Treatments}" DisplayMemberPath="DisplayInfo" SelectedValuePath="TreatmentID" SelectedValue="{Binding TreatmentID, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormComboBoxStyle}" />
        <!-- Appointment Date -->
        <Label Content="Fecha de Cita" Style="{StaticResource FormLabelStyle}" />
        <DatePicker SelectedDate="{Binding AppointmentDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormDatePickerStyle}" />
        <!-- Start Time -->
        <Label Content="Hora de Inicio" Style="{StaticResource FormLabelStyle}" />
        <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" ToolTip="Formato: HH:mm (ej: 09:00)" Style="{StaticResource FormTextBoxStyle}" />
        <!-- End Time -->
        <Label Content="Hora de Fin" Style="{StaticResource FormLabelStyle}" />
        <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" ToolTip="Formato: HH:mm (ej: 10:00)" Style="{StaticResource FormTextBoxStyle}" />
        <!-- Notes -->
        <Label Content="Notas" Style="{StaticResource FormLabelStyle}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AcceptsReturn="True"  TextWrapping="Wrap" Style="{StaticResource FormTextBoxStyle}" />
      </StackPanel>
    
    <!-- Buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
      <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}"  Margin="5" />
      <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}"  Margin="5" />
    </StackPanel>
  </Grid>
    
</Window>

