<Window x:Class="DentalClinicWPF.Views.Employee.AddEmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Empleado" Height="650" Width="500" WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Input Fields -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!-- First Name -->
                <Label Content="Nombre" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource FormTextBoxStyle}" />

                <!-- Last Name -->
                <Label Content="Apellido" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource FormTextBoxStyle}" />

                <!-- Position -->
                <Label Content="Puesto" Style="{StaticResource FormLabelStyle}" />
                <ComboBox SelectedValue="{Binding Position, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          SelectedValuePath="Content"
                          Style="{StaticResource FormComboBoxStyle}">
                    <ComboBoxItem Content="Recepcionista" />
                    <ComboBoxItem Content="Asistente Dental" />
                </ComboBox>

                <!-- Phone Number -->
                <Label Content="Teléfono" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource FormTextBoxStyle}" />

                <!-- Email -->
                <Label Content="Correo" Style="{StaticResource FormLabelStyle}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource FormTextBoxStyle}" />

                <!-- Assign to Dentist (Optional) -->
                <Label Content="Asignar a Dentista (Opcional)" Style="{StaticResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Dentists}"
                          DisplayMemberPath="DisplayInfo"
                          SelectedValuePath="DentistID"
                          SelectedValue="{Binding DentistID, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource FormComboBoxStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}" Width="100" Margin="5" />
        </StackPanel>
    </Grid>
</Window>

