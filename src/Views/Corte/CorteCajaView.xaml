<UserControl x:Class="DentalClinicWPF.Views.Corte.CorteCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Corte de Caja" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Consulta los ingresos y tickets generados por día" FontSize="14" Foreground="#64748B" Margin="0,0,0,24"/>

            <!-- Barra de Acciones -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Seleccionar Fecha:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                    <Button Command="{Binding GenerarCorteCommand}" Background="#14B8A6" Foreground="White" Padding="20,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        Actualizar Corte
                    </Button>
                </StackPanel>
            </Border>

            <!-- Tarjetas de KPI (Resumen del Día) -->
            <UniformGrid Columns="2" Margin="0,0,0,24">
                <!-- Total Ingresos -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" Background="#DCFCE7" CornerRadius="10" Margin="0,0,16,0">
                            <TextBlock Text="$" FontSize="24" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ingresos del Día" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalIngresos, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Cantidad Tickets -->
                <Border Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" Background="#E0F2FE" CornerRadius="10" Margin="0,0,16,0">
                            <TextBlock Text="T" FontSize="24" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tickets Emitidos" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Text="{Binding CantidadTickets}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Tabla de Detalle -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Detalle de Tickets del Día" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding TicketsDelDia}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="40">
                        <DataGrid.Columns>
                            <!-- NOTA: Si en tu modelo la propiedad no se llama "Date", cámbialo aquí abajo -->
                            <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100"/>
                            <DataGridTextColumn Header="Paciente" Binding="{Binding Patient.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding TotalAmount, StringFormat=C}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>


