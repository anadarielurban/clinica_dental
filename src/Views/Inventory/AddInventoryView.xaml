<Window x:Class="DentalClinicWPF.Views.Inventory.AddInventoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Inventario" Height="450" Width="600" WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Input Fields -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Nombre del Producto" />
                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Inventory.ProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />

                <Label Content="Cantidad" />
                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Inventory.Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />

                <Label Content="Nivel de Reorden" />
                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Inventory.ReorderLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />

                <Label Content="Proveedor" />
                <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Suppliers}" 
                          DisplayMemberPath="CompanyName" 
                          SelectedValuePath="SupplierID" 
                          SelectedValue="{Binding Inventory.SupplierID, UpdateSourceTrigger=PropertyChanged}" 
                          Margin="0,5" />

                <Label Content="Consultorio" />
                <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Rooms}" 
                          DisplayMemberPath="RoomNumber" 
                          SelectedValuePath="RoomID" 
                          SelectedValue="{Binding Dentist.RoomID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Margin="0,5" />

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Width="100" Margin="5" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Width="100" Margin="5" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>

