<UserControl x:Class="DentalClinicWPF.Views.Patient.PatientDetail.OdontogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Tooltip redondeado -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de diente con hover suave -->
        <Style x:Key="ToothButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/><Setter Property="MaxWidth" Value="56"/><Setter Property="MinHeight" Value="46"/><Setter Property="MaxHeight" Value="78"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="2"
                                BorderThickness="0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E6F7F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#CCFBF1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#CCFBF1"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#14B8A6"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de cuadrante -->
        <Style x:Key="QuadrantLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <!-- Item template del diente (compartido) -->
        <DataTemplate x:Key="ToothTemplate">
            <Button Style="{StaticResource ToothButtonStyle}" ToolTip="{Binding Condition}"
                    Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Sano" Command="{Binding ChangeStateCommand}" CommandParameter="Sano"/>
                        <MenuItem Header="Caries" Command="{Binding ChangeStateCommand}" CommandParameter="Caries"/>
                        <MenuItem Header="Resina" Command="{Binding ChangeStateCommand}" CommandParameter="Resina"/>
                        <MenuItem Header="Endodoncia" Command="{Binding ChangeStateCommand}" CommandParameter="Endodoncia"/>
                        <MenuItem Header="Corona" Command="{Binding ChangeStateCommand}" CommandParameter="Corona"/>
                        <MenuItem Header="Extraído" Command="{Binding ChangeStateCommand}" CommandParameter="Extraido"/>
                        <MenuItem Header="Implante" Command="{Binding ChangeStateCommand}" CommandParameter="Implante"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Path Data="M 15,5 C 25,0 35,0 45,5 C 50,15 50,30 45,40 L 40,60 C 40,65 35,65 35,60 L 30,45 L 30,60 C 30,65 25,65 25,60 L 20,45 L 20,60 C 20,65 15,65 15,60 L 10,40 C 5,30 5,15 10,5 Z"
                          Stretch="Uniform"
                          Fill="{Binding BackgroundColor}"
                          Stroke="#CBD5E1"
                          StrokeThickness="1"
                          Margin="6"/>
                    <TextBlock Text="{Binding ToothNumber}"
                               Foreground="{Binding TextColor}"
                               FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <Ellipse Width="7" Height="7" Fill="#14B8A6"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,4,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Item template del diente INVERTIDO (para el maxilar inferior) -->
        <DataTemplate x:Key="ToothInvertedTemplate">
            <Button Style="{StaticResource ToothButtonStyle}" ToolTip="{Binding Condition}"
                    Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Sano" Command="{Binding ChangeStateCommand}" CommandParameter="Sano"/>
                        <MenuItem Header="Caries" Command="{Binding ChangeStateCommand}" CommandParameter="Caries"/>
                        <MenuItem Header="Resina" Command="{Binding ChangeStateCommand}" CommandParameter="Resina"/>
                        <MenuItem Header="Endodoncia" Command="{Binding ChangeStateCommand}" CommandParameter="Endodoncia"/>
                        <MenuItem Header="Corona" Command="{Binding ChangeStateCommand}" CommandParameter="Corona"/>
                        <MenuItem Header="Extraído" Command="{Binding ChangeStateCommand}" CommandParameter="Extraido"/>
                        <MenuItem Header="Implante" Command="{Binding ChangeStateCommand}" CommandParameter="Implante"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Path Data="M 15,5 C 25,0 35,0 45,5 C 50,15 50,30 45,40 L 40,60 C 40,65 35,65 35,60 L 30,45 L 30,60 C 30,65 25,65 25,60 L 20,45 L 20,60 C 20,65 15,65 15,60 L 10,40 C 5,30 5,15 10,5 Z"
                          Stretch="Uniform"
                          Fill="{Binding BackgroundColor}"
                          Stroke="#CBD5E1"
                          StrokeThickness="1"
                          Margin="6"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
                    </Path>
                    <TextBlock Text="{Binding ToothNumber}"
                               Foreground="{Binding TextColor}"
                               FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <Ellipse Width="7" Height="7" Fill="#14B8A6"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,4,4">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Odontograma" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Clic derecho sobre un diente para registrar su estado"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0FDFA" CornerRadius="20" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🦷" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Foreground="#0F766E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                                <Run Text="{Binding AffectedTeethCount, Mode=OneWay}"/>
                                <Run Text=" con hallazgos"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding SaveOdontogramCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="#14B8A6" CornerRadius="8" Padding="16,9">
                                    <TextBlock Text="Guardar Cambios" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#0D9488"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ ODONTOGRAMA + PANEL LATERAL ══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300" MinWidth="280" MaxWidth="340"/>
            </Grid.ColumnDefinitions>

        <!-- (Tarjeta del odontograma) -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Etiquetas superiores -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SUPERIOR DERECHO" Style="{StaticResource QuadrantLabelStyle}"/>
                    <TextBlock Grid.Column="2" Text="SUPERIOR IZQUIERDO" Style="{StaticResource QuadrantLabelStyle}"/>
                </Grid>

                <!-- Cuadrante superior -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Línea media -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,10"/>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding TeethUpperRight}"
                                  ItemTemplate="{StaticResource ToothTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding TeethUpperLeft}"
                                  ItemTemplate="{StaticResource ToothTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Línea oclusal -->
                <Grid Grid.Row="2" Margin="0,12">
                    <Rectangle Height="1" Fill="#E2E8F0" VerticalAlignment="Center"/>
                    <Border Background="White" CornerRadius="10" Padding="10,2" HorizontalAlignment="Center">
                        <TextBlock Text="PLANO OCLUSAL" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                </Grid>

                <!-- Cuadrante inferior -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,10"/>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding TeethLowerRight}"
                                  ItemTemplate="{StaticResource ToothInvertedTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding TeethLowerLeft}"
                                  ItemTemplate="{StaticResource ToothInvertedTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- Etiquetas inferiores -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="INFERIOR DERECHO" Style="{StaticResource QuadrantLabelStyle}"/>
                    <TextBlock Grid.Column="2" Text="INFERIOR IZQUIERDO" Style="{StaticResource QuadrantLabelStyle}"/>
                </Grid>
            </Grid>
        </Border>

            <!-- ══════════ PANEL LATERAL: NOTAS DEL DIENTE ══════════ -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <!-- Estado vacío: nada seleccionado -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTooth}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="👆" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecciona un diente" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Haz clic en cualquier diente&#10;para ver o editar sus notas"
                                   FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Detalle del diente seleccionado -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTooth}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="DIENTE" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding SelectedTooth.ToothNumber, StringFormat=#{0}}"
                                   FontSize="32" FontWeight="Bold" Foreground="#14B8A6" Margin="0,2,0,10"/>

                        <TextBlock Text="ESTADO ACTUAL" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <Border Background="#F0FDFA" CornerRadius="6" Padding="10,6" Margin="0,4,0,16">
                            <TextBlock Text="{Binding SelectedTooth.Condition}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>

                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"><Run Text="NOTAS "/><Run Text="(opcional)" Foreground="#CBD5E1" FontWeight="Normal"/></TextBlock>
                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                                Padding="8" Margin="0,4,0,12">
                            <TextBox Text="{Binding SelectedTooth.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="100" MaxHeight="200"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" Foreground="#1E293B"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <Border Background="#FFF7ED" CornerRadius="6" Padding="10,8" BorderBrush="#FED7AA" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Guarda con el botón&#10;&quot;Guardar Cambios&quot; del encabezado."
                                           FontSize="10" Foreground="#9A3412" TextWrapping="Wrap" Width="200"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ LEYENDA ══════════ -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,10" Margin="0,16,0,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Leyenda:" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Caries" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Resina" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Ellipse Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Endodoncia" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Corona" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Ellipse Width="10" Height="10" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Extraído" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Implante" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>



