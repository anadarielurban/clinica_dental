<UserControl x:Class="DentalClinicWPF.Views.Patient.PatientDetail.PeriodontalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F8FAFC" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Periodontograma (Sondaje y Movilidad)" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                <Button Content="Recargar Dientes" Command="{Binding LoadDataCommand}" 
                Background="#14B8A6" Foreground="White" Padding="10,5" 
                BorderThickness="0" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Left"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Diente" Binding="{Binding ToothNumber}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Sondaje (6 sitios ej: 3-2-3-3-2-3)" Binding="{Binding ProbingDepths}" Width="*"/>
                <DataGridCheckBoxColumn Header="Sangrado" Binding="{Binding Bleeding}" Width="100"/>
                <DataGridTextColumn Header="Movilidad (0-3)" Binding="{Binding Mobility}" Width="120"/>
                <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>