<UserControl x:Class="DentalClinicWPF.Views.Patient.PatientDetail.MedicalHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <StackPanel Margin="20" MaxWidth="900">

            <!-- Header -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Historia Clínica" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Antecedentes y condiciones médicas relevantes para el tratamiento"
                                   FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding SaveCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="#14B8A6" CornerRadius="8" Padding="16,9">
                                    <TextBlock Text="Guardar Cambios" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#0D9488"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#0F766E"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Tipo de sangre -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TIPO DE SANGRE" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox SelectedValue="{Binding BloodType}" SelectedValuePath="Content" Width="120" HorizontalAlignment="Left" FontSize="13" Padding="8,6">
                        <ComboBoxItem Content="A+"/>
                        <ComboBoxItem Content="A-"/>
                        <ComboBoxItem Content="B+"/>
                        <ComboBoxItem Content="B-"/>
                        <ComboBoxItem Content="AB+"/>
                        <ComboBoxItem Content="AB-"/>
                        <ComboBoxItem Content="O+"/>
                        <ComboBoxItem Content="O-"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Condiciones médicas -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="CONDICIONES MÉDICAS" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid Columns="2">
                        <CheckBox Content="Diabetes" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding HasDiabetes}"/>
                        <CheckBox Content="Hipertensión" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding HasHypertension}"/>
                        <CheckBox Content="Problemas cardíacos" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding HasHeartConditions}"/>
                        <CheckBox Content="Problemas de coagulación" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding HasCoagulationIssues}"/>
                        <CheckBox Content="Toma anticoagulantes" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding TakesAnticoagulants}"/>
                        <CheckBox Content="Embarazo" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding IsPregnant}"/>
                        <CheckBox Content="Fumador" Style="{StaticResource MedCheckBoxStyle}" IsChecked="{Binding IsSmoker}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Alergias -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ALERGIAS" Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox Content="¿El paciente tiene alergias?" IsChecked="{Binding HasAllergies}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding AllergiesDetails, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasAllergies}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="120"
                             Padding="10" FontSize="12"
                             Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="Ej. Penicilina, látex, anestesia, etc."
                               FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Contacto de emergencia -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="CONTACTO DE EMERGENCIA" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre completo" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EmergencyContactName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" FontSize="12" Background="#F8FAFC"
                                     BorderBrush="#E2E8F0" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Teléfono" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" FontSize="12" Background="#F8FAFC"
                                     BorderBrush="#E2E8F0" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notas médicas -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="NOTAS MÉDICAS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#CBD5E1" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="100" MaxHeight="180"
                             Padding="10" FontSize="12"
                             Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    <TextBlock Text="Cirugías previas, medicamentos actuales, observaciones..."
                               FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
