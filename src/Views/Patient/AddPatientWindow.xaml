<Window x:Class="DentalClinicWPF.Views.Patient.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Nuevo Paciente" Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                
                <Label Content="Nombre" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10"/>

                <Label Content="Apellido" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10"/>

                <Label Content="Fecha de Nacimiento" Foreground="{StaticResource Brush.TextPrimary}"/>
                <DatePicker SelectedDate="{Binding DateOfBirth}" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center"/>

                <Label Content="Género" Foreground="{StaticResource Brush.TextPrimary}"/>
                <ComboBox SelectedValue="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Masculino" Tag="Male"/>
                    <ComboBoxItem Content="Femenino" Tag="Female"/>
                </ComboBox>

                <Label Content="Teléfono" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10"/>

                <Label Content="Correo" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10"/>

                <Label Content="Dirección" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" 
                    Style="{StaticResource Modern.Button.Secondary}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Guardar" Command="{Binding SaveCommand}" 
                    Style="{StaticResource Modern.Button.Primary}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>