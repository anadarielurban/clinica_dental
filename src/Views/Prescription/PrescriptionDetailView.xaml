<UserControl x:Class="DentalClinicWPF.Views.Prescription.PrescriptionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" Width="800" Height="620">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Detalle de la Receta" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Información clínica del paciente" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Background="#F1F5F9" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Prescription.Date, StringFormat='Emitida el: {0:dd/MM/yyyy}'}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                
                <!-- Tarjetas de Paciente y Doctor -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paciente -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PACIENTE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Prescription.Patient.FirstName}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Prescription.Patient.PhoneNumber}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Doctor -->
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ODONTÓLOGO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Prescription.Dentist.FirstName}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Prescription.Dentist.Specialization}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tarjeta de Medicamento -->
                <Border Background="White" CornerRadius="10" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MEDICAMENTO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Prescription.Medication}" FontSize="26" FontWeight="Black" Foreground="#0F172A" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="DOSIS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="15,8">
                                    <TextBlock Text="{Binding Prescription.Dosage}" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,25"/>

                        <StackPanel>
                            <TextBlock Text="INDICACIONES MÉDICAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Prescription.Instructions}" FontSize="15" Foreground="#334155" TextWrapping="Wrap" LineHeight="26"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTONES DE ACCIÓN -->
        <Border Grid.Row="2" Background="White" Padding="20,15" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Vista Previa -->
                <Button Content="Vista Previa" Width="120" Height="40" Margin="0,0,10,0" 
                        Background="#EEF2FF" Foreground="#4F46E5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnPreview_Click"/>
                <!-- Exportar PDF -->
                <Button Content="Exportar PDF" Width="130" Height="40" Margin="0,0,10,0" 
                        Background="#ECFDF5" Foreground="#059669" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnExport_Click"/>
                <!-- Imprimir -->
                <Button Content="Imprimir" Width="110" Height="40" Margin="0,0,10,0" 
                        Background="#FFF7ED" Foreground="#EA580C" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnImprimir_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>