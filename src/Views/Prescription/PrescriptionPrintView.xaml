<UserControl x:Class="DentalClinicWPF.Views.Prescription.PrescriptionPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="793" Height="1122" Background="White">
    <Grid Margin="40,40,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nexup" FontSize="36" FontWeight="Black" Foreground="#2B3464" FontFamily="Segoe UI"/>
                <TextBlock Text="DENTAL" FontSize="14" FontWeight="Bold" Foreground="#00A8E1" Margin="5,10,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Dra. Nayeli Sandoval Chavez" FontSize="16" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Right"/>
                <TextBlock Text="Cédula Profesional: 15794017" FontSize="12" Foreground="#00A8E1" HorizontalAlignment="Right" Margin="0,2,0,2"/>
                <TextBlock Text="Cirujano Dentista" FontSize="12" Foreground="#777777" HorizontalAlignment="Right"/>
                <TextBlock Text="Odontología General" FontSize="12" Foreground="#777777" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- LÍNEA DIVISORIA -->
        <Rectangle Grid.Row="1" Height="4" Margin="0,0,0,30">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00A8E1" Offset="0.0"/>
                    <GradientStop Color="#00A8E1" Offset="0.4"/>
                    <GradientStop Color="#2B3464" Offset="0.4"/>
                    <GradientStop Color="#2B3464" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- DATOS DEL PACIENTE -->
        <StackPanel Grid.Row="2" Margin="0,0,0,30">
            <TextBlock Text="Nombre:" FontSize="14" FontWeight="Bold" Foreground="#555555"/>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,5,0,0" Padding="10,0">
                <TextBlock x:Name="TxtPatientName" FontSize="16" VerticalAlignment="Center" Foreground="#333333"/>
            </Border>
        </StackPanel>

        <!-- CUERPO DE LA RECETA -->
        <StackPanel Grid.Row="3">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtMedication" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock x:Name="TxtInstructions" FontSize="14" Foreground="#666666" TextWrapping="Wrap" Margin="0,8,20,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDosage" FontSize="16" FontWeight="SemiBold" Foreground="#2B3464" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- FIRMA -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,40,0,40">
            <Line X1="0" Y1="0" X2="250" Y2="0" Stroke="#999999" StrokeThickness="1"/>
            <TextBlock Text="Firma y sello del médico" FontSize="12" Foreground="#777777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Grid.Row="5" Margin="0,20,0,0">
            <Rectangle Height="2" Fill="#00A8E1" Margin="0,0,0,10"/>
            <TextBlock Text="Blvd Plan de Guadalupe No.166, Col. Centro" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Ramos Arizpe, Coahuila, C.P. 25900" FontSize="12" Foreground="#555555" Margin="0,2,0,2"/>
            <TextBlock Text="(844) 204 1521 · Citas y urgencias" FontSize="12" Foreground="#777777"/>
        </StackPanel>
    </Grid>
</UserControl>