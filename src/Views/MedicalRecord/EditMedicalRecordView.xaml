<Window x:Class="DentalClinicWPF.Views.MedicalRecord.EditMedicalRecordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Expediente" Height="600" Width="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <Label Content="Paciente" />
            <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Patients}" 
                      DisplayMemberPath="DisplayInfo" 
                      SelectedValuePath="PatientID" 
                      SelectedValue="{Binding MedicalRecord.PatientID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="0,5,0,10" />

            <Label Content="Dentista" />
            <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Dentists}" 
                      DisplayMemberPath="DisplayInfo" 
                      SelectedValuePath="DentistID" 
                      SelectedValue="{Binding MedicalRecord.DentistID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="0,5,0,10" />

            <Label Content="Fecha" />
            <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding MedicalRecord.Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,5,0,10" />

            <Label Content="Notas" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding MedicalRecord.Notes, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" Height="100" Margin="0,5,0,10" />

            <Label Content="Adjuntos (opcional)" />
            <Button Content="Subir Adjunto" Width="150" Margin="0,5,0,10" 
                    Command="{Binding UploadAttachmentCommand}" />
            <Button Content="Abrir Adjunto" Width="150" Margin="0,5,0,10" 
                    Command="{Binding OpenAttachmentCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}" Width="100" Margin="5" />
        </StackPanel>
    </Grid>
</Window>

