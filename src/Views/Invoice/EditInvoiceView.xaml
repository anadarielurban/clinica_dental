<Window Width="900" Height="700" x:Class="DentalClinicWPF.Views.Invoice.EditInvoiceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editar Factura" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}"    >
    
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Input Fields -->
    
      <StackPanel>
        <Label Content="Cita" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Appointments}" DisplayMemberPath="DisplayInfo" SelectedValuePath="AppointmentID" SelectedValue="{Binding Invoice.AppointmentID, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
        <Label Content="Fecha de Factura" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Invoice.InvoiceDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
        <Label Content="Monto Total" />
        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Invoice.TotalAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
        <Label Content="Estado de Pago" />
        <CheckBox Content="Pagada" IsChecked="{Binding Invoice.IsPaid, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
      </StackPanel>
    
    <!-- Buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar"  Margin="5" Command="{Binding CancelCommand}" />
      <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar"  Margin="5" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
    
</Window>

