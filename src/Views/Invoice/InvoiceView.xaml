<UserControl x:Class="DentalClinicWPF.Views.Invoice.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource Brush.Background}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Paginación -->
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Facturas" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Historial de facturación y ventas" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- FILTROS Y BÚSQUEDA -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buscador -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Background}" CornerRadius="8" Height="38"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="0,0,15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="13"
                                 Foreground="{StaticResource Brush.TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Buscar por paciente o ID de factura"/>
                    </Grid>
                </Border>

                <!-- Filtro Fechas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Desde:" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,5,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="110" Height="30" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Hasta:" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="10,0,5,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="110" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Botón Recargar -->
                <Button Grid.Column="4" Command="{Binding ReloadCommand}" Style="{StaticResource Modern.Button.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Recargar" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False"
                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                          IsReadOnly="True" SelectionMode="Single" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          RowHeight="44" Margin="8">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#CCFBF1"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding InvoiceID, StringFormat='#{0:D6}'}" Width="80"/>
                        <DataGridTextColumn Header="Paciente" Binding="{Binding Patient.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Dentista" Binding="{Binding Appointment.Dentist.FullName, TargetNullValue='-'}" Width="*"/>
                        <DataGridTextColumn Header="Tratamiento" Binding="{Binding Appointment.Treatment.Name, TargetNullValue='Servicio POS'}" Width="*"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Pagada" Binding="{Binding IsPaid, Mode=OneWay}" Width="70"/>
                        <DataGridTemplateColumn Header="Acciones" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PrintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ver / Imprimir Factura">
                                        <TextBlock Text="🖨️" FontSize="16" Foreground="#14B8A6"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Invoices.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin facturas en este rango de fechas" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Cambia las fechas o realiza una venta en el Punto de Venta" FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAGINACIÓN -->
        <Border Grid.Row="3" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="12,8" Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding PrevPageCommand}" Content="Anterior" Style="{StaticResource Modern.Button.Secondary}" Margin="0,0,10,0" Padding="15,5"/>
                    <Button Command="{Binding NextPageCommand}" Content="Siguiente" Style="{StaticResource Modern.Button.Secondary}" Padding="15,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>