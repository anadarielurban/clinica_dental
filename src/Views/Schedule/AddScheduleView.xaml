<!-- Views/Schedule/AddScheduleView.xaml -->
<Window Width="900" Height="700" x:Class="DentalClinicWPF.Views.Schedule.AddScheduleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agregar Horario" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}"    >
    
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <Label Content="Dentista" />
      <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Dentists}" DisplayMemberPath="DisplayInfo" SelectedValuePath="DentistID" SelectedValue="{Binding Schedule.DentistID}" Margin="0,5" />
      <Label Content="Fecha de Inicio" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Schedule.StartDate}" />
      <Label Content="Fecha de Fin" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Schedule.EndDate}" />
      <Label Content="Hora de Inicio" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Schedule.StartTime}" IsReadOnly="True" />
      <Label Content="Hora de Fin" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Schedule.EndTime}" IsReadOnly="True" />
      <CheckBox Content="Día Libre" IsChecked="{Binding Schedule.IsDayOff}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}"  Margin="5" />
      <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}"  Margin="5" />
    </StackPanel>
  </Grid>
    
</Window>

