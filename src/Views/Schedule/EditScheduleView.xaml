<!-- Views/Schedule/EditScheduleView.xaml -->
<Window x:Class="DentalClinicWPF.Views.Schedule.EditScheduleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Horario" Height="400" Width="400" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Label Content="Dentista" />
            <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Dentists}" 
                      DisplayMemberPath="FullName" 
                      SelectedValuePath="DentistID" 
                      SelectedValue="{Binding Schedule.DentistID}" />

            <Label Content="Fecha de Inicio" />
            <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Schedule.StartDate}" />

            <Label Content="Fecha de Fin" />
            <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Schedule.EndDate}" />

            <Label Content="Hora de Inicio" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Schedule.StartTime}" IsReadOnly="True" />

            <Label Content="Hora de Fin" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Schedule.EndTime}" IsReadOnly="True" />

            <CheckBox Content="Día Libre" IsChecked="{Binding Schedule.IsDayOff}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}" Width="100" Margin="5" />
            <Button Style="{StaticResource Modern.Button.Danger}" Content="Eliminar" Command="{Binding DeleteCommand}" Width="100" Margin="5" />
        </StackPanel>
    </Grid>
</Window>
