<Window x:Class="DentalClinicWPF.Views.Treatment.EditTreatmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Tratamiento"
        Height="620" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="Editar Tratamiento"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Modifica los datos del tratamiento"
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <TextBlock Text="Nombre" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,8,0,6"/>
                <TextBox Text="{Binding EditingTreatment.Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="38" Padding="10,0" FontSize="14"
                         Background="{StaticResource Brush.Surface}"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         BorderBrush="{StaticResource Brush.Border}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Descripción" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,16,0,6"/>
                <TextBox Text="{Binding EditingTreatment.Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="90" Padding="10,8" FontSize="14"
                         Background="{StaticResource Brush.Surface}"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         BorderBrush="{StaticResource Brush.Border}"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Precio (MXN)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding EditingTreatment.Price, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="10,0" FontSize="14"
                             Background="{StaticResource Brush.Surface}"
                             Foreground="{StaticResource Brush.TextPrimary}"
                             BorderBrush="{StaticResource Brush.Border}"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MXN"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>

                <TextBlock Text="Duración (minutos)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,16,0,6"/>
                <TextBox Text="{Binding EditingTreatment.Duration, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                         Height="38" Padding="10,0" FontSize="14"
                         Background="{StaticResource Brush.Surface}"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         BorderBrush="{StaticResource Brush.Border}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Modern.Button.Secondary}"
                        Margin="0,0,10,0"/>
                <Button Content="Eliminar"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource Modern.Button.Danger}"
                        Margin="0,0,10,0"/>
                <Button Content="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Modern.Button.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
