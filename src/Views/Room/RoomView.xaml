<UserControl x:Class="DentalClinicWPF.Views.Room.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DentalClinicWPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Sorting -->
            <RowDefinition Height="*" />    <!-- Data Grid -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="300" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" 
                     ToolTip="Buscar por número de consultorio" 
                     Margin="0,0,10,0" />
            <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,10,0" Width="100" />
            <Button Content="Recargar" Command="{Binding ReloadCommand}" Margin="0,0,10,0" Width="100" />
            <Button Content="Agregar Consultorio" Command="{Binding AddRoomCommand}" Width="150" Margin="0,0,10,0" />
            <Button Content="Editar Consultorio" Command="{Binding EditRoomCommand}" 
                    Width="150" 
                    Margin="0,0,10,0" 
                    IsEnabled="{Binding SelectedRoom, Converter={StaticResource NullToBoolConverter}}" />
        </StackPanel>

        <!-- Sorting Section -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <ComboBox Width="150" ItemsSource="{Binding SortOptions}" 
                      SelectedItem="{Binding SelectedSortOption}" 
                      ToolTip="Seleccionar criterio de ordenamiento" 
                      Margin="0,0,10,0" />
            <Button Content="Ordenar" Command="{Binding SortCommand}" Width="100" />
        </StackPanel>

        <!-- Room List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rooms}" 
                  AutoGenerateColumns="False" 
                  SelectedItem="{Binding SelectedRoom}" 
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding RoomNumber}" Width="*" />
                <DataGridCheckBoxColumn Header="Disponible" Binding="{Binding IsAvailable}" Width="*" />
                <DataGridTextColumn Header="Equipos" Binding="{Binding Equipments.Count}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
