<Window x:Class="DentalClinicWPF.Views.Equipment.EditEquipmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Equipo" Height="600" Width="600" WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="Red" BorderThickness="1">
                                <AdornedElementPlaceholder />
                            </Border>
                            <TextBlock Foreground="Red" 
                                       Text="{Binding [0].ErrorContent}" 
                                       FontSize="12" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel>
            <Label Content="Nombre" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingEquipment.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <Label Content="Modelo" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingEquipment.Model, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <Label Content="Número de Serie" />
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingEquipment.SerialNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <Label Content="Fecha de Compra" />
            <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding EditingEquipment.PurchaseDate}" />

            <Label Content="Último Servicio" />
            <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding EditingEquipment.LastServiceDate}" />

            <Label Content="Consultorio" />
            <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Rooms}" 
                      SelectedItem="{Binding SelectedRoom}" 
                      DisplayMemberPath="RoomNumber" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,20,0,0">
                <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Width="100" />
                <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}" Width="100" />
                <Button Style="{StaticResource Modern.Button.Danger}" Content="Eliminar" Command="{Binding DeleteCommand}" Width="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

