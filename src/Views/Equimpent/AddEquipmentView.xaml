<Window Width="900" Height="700" x:Class="DentalClinicWPF.Views.Equipment.AddEquipmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agregar Equipo" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}"    >
    
  <Window.Resources>
    
    <Style TargetType="TextBox">
      <Setter Property="Validation.ErrorTemplate">
        <Setter.Value>
          <ControlTemplate>
            <StackPanel>
              <Border BorderBrush="Red" BorderThickness="1">
                <AdornedElementPlaceholder />
              </Border>
              <TextBlock Foreground="Red" Text="{Binding [0].ErrorContent}" FontSize="12" />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <StackPanel>
      <Label Content="Nombre" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Equipment.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
      <Label Content="Modelo" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Equipment.Model, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
      <Label Content="Número de Serie" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Equipment.SerialNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
      <Label Content="Fecha de Compra" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Equipment.PurchaseDate}" />
      <Label Content="Ãšltimo Servicio" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding Equipment.LastServiceDate}" />
      <Label Content="Consultorio" />
      <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="RoomNumber" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,20,0,0">
        <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}"  />
        <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Command="{Binding SaveCommand}"  />
      </StackPanel>
    </StackPanel>
  </Grid>
    
</Window>

