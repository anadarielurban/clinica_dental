<UserControl x:Class="DentalClinicWPF.Views.Equipment.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DentalClinicWPF.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Sorting -->
            <RowDefinition Height="*" />    <!-- Equipment List -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="300" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" 
                     ToolTip="Buscar por nombre, modelo o número de serie" 
                     Margin="0,0,10,0" />
            <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,10,0" Width="100" />
            <Button Content="Recargar" Command="{Binding ReloadCommand}" Margin="0,0,10,0" Width="100" />
            <Button Content="Agregar Equipo" Command="{Binding AddEquipmentCommand}" Width="150" Margin="0,0,10,0" />
            <Button Content="Editar Equipo" Command="{Binding EditEquipmentCommand}" 
                    Width="150" Margin="0,0,10,0" 
                    IsEnabled="{Binding SelectedEquipment, Converter={StaticResource NullToBoolConverter}}" />
        </StackPanel>

        <!-- Sorting -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <ComboBox Width="150" ItemsSource="{Binding SortOptions}" 
                      SelectedItem="{Binding SelectedSortOption}" 
                      ToolTip="Seleccionar criterio de ordenamiento" 
                      Margin="0,0,10,0" />
            <Button Content="Ordenar" Command="{Binding SortCommand}" Width="100" />
        </StackPanel>

        <!-- Equipment List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding EquipmentList}" 
                  AutoGenerateColumns="False" 
                  SelectedItem="{Binding SelectedEquipment}" 
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="Número de Serie" Binding="{Binding SerialNumber}" Width="*" />
                <DataGridTextColumn Header="Fecha de Compra" Binding="{Binding PurchaseDate, StringFormat=d}" Width="*" />
                <DataGridTextColumn Header="Último Servicio" Binding="{Binding LastServiceDate, StringFormat=d}" Width="*" />
                <DataGridTextColumn Header="Consultorio" Binding="{Binding Room.RoomNumber}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
