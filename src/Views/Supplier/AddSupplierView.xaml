<Window x:Class="DentalClinicWPF.Views.Supplier.AddSupplierView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Proveedor" Height="400" Width="600" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Fields -->
        <StackPanel>
            <Label Content="Nombre de la Empresa"/>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Supplier.CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <Label Content="Nombre de Contacto"/>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Supplier.ContactName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <Label Content="Teléfono"/>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Supplier.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <Label Content="Correo"/>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Supplier.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <Label Content="Dirección"/>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Supplier.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar" Width="100" Margin="5" Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar" Width="100" Margin="5" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
