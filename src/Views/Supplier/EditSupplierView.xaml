<Window Width="900" Height="700" x:Class="DentalClinicWPF.Views.Supplier.EditSupplierView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editar Proveedor" Background="{StaticResource Brush.Background}" FontFamily="{StaticResource Font.Primary}"    >
    
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Input Fields -->
    <StackPanel>
      <Label Content="Nombre de la Empresa" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingSupplier.CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
      <Label Content="Nombre de Contacto" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingSupplier.ContactName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
      <Label Content="Teléfono" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingSupplier.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
      <Label Content="Correo" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingSupplier.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
      <Label Content="Dirección" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding EditingSupplier.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
    </StackPanel>
    <!-- Buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Style="{StaticResource Modern.Button.Secondary}" Content="Cancelar"  Margin="5" Command="{Binding CancelCommand}" />
      <Button Style="{StaticResource Modern.Button.Primary}" Content="Guardar"  Margin="5" Command="{Binding SaveCommand}" />
      <Button Style="{StaticResource Modern.Button.Danger}" Content="Eliminar"  Margin="5" Command="{Binding DeleteCommand}" />
    </StackPanel>
  </Grid>
    
</Window>

