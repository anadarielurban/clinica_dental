<Window x:Class="DentalClinicWPF.Views.TreatmentPlan.AddTreatmentPlanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Plan de Tratamiento"
        Height="600" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="Agregar Plan de Tratamiento"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Ingresa los datos del nuevo plan"
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <TextBlock Text="Paciente" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,8,0,6"/>
                <ComboBox ItemsSource="{Binding Patients}"
                          DisplayMemberPath="DisplayInfo"
                          SelectedValuePath="PatientID"
                          SelectedValue="{Binding TreatmentPlan.PatientID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="38" Padding="10,0" FontSize="14"
                          Background="{StaticResource Brush.Surface}"
                          Foreground="{StaticResource Brush.TextPrimary}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="Dentista" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,16,0,6"/>
                <ComboBox ItemsSource="{Binding Dentists}"
                          DisplayMemberPath="DisplayInfo"
                          SelectedValuePath="DentistID"
                          SelectedValue="{Binding TreatmentPlan.DentistID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="38" Padding="10,0" FontSize="14"
                          Background="{StaticResource Brush.Surface}"
                          Foreground="{StaticResource Brush.TextPrimary}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="Detalles" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,16,0,6"/>
                <TextBox Text="{Binding TreatmentPlan.Details, UpdateSourceTrigger=PropertyChanged}"
                         Height="120" Padding="10,8" FontSize="14"
                         Background="{StaticResource Brush.Surface}"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         BorderBrush="{StaticResource Brush.Border}"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Modern.Button.Secondary}"
                        Margin="0,0,10,0"/>
                <Button Content="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Modern.Button.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
