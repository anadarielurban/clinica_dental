<UserControl x:Class="DentalClinicWPF.Views.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Buscador -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Punto de Venta" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Buscar Tratamiento o Producto:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,5" Background="#F8FAFC" CornerRadius="5" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat=C}" FontSize="12" Foreground="#10B981"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Agregar" Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Description}" Background="#14B8A6" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Carrito y Cobro -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Paciente:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="FullName" Padding="8" FontSize="14" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Vincular a Cita (Opcional):" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableAppointments}" SelectedItem="{Binding SelectedAppointment}" DisplayMemberPath="DisplayInfo" Padding="8" FontSize="14"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat=C}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#14B8A6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Método de Pago" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="8" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Efectivo Recibido" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AmountReceived, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#F0FDFA" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="Cambio:" FontSize="14" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Change, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Content="💵 Cobrar e Imprimir Ticket" Command="{Binding CheckoutCommand}" Background="#14B8A6" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
