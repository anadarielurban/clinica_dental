<UserControl x:Class="DentalClinicWPF.Views.Dentist.DentistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DentalClinicWPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <!-- View Resources: styles from DentistStyles.xaml and CountToVisibilityConverter -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Path to the styles file -->
                <ResourceDictionary Source="/DentalClinicWPF;component/Styles/DentistStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter to display "No appointments" -->
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            
            <!-- TimeSpan to String Converter -->
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Main grid: 2 rows and 2 columns -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Rest -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/> <!-- Left panel -->
            <ColumnDefinition Width="*"/>   <!-- Right part -->
        </Grid.ColumnDefinitions>

        <!-- Header moderno con avatar + nombre -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Surface}"
                CornerRadius="12" Padding="24"
                Margin="20,20,20,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52"
                        Background="{StaticResource Brush.PrimarySoft}"
                        CornerRadius="26">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource Brush.PrimaryPressed}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Dentist.FullName}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Text="Dentista"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Panel izquierdo: Info + Disponibilidad + Rendimiento -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="20,0,10,20">
            <TextBlock Text="INFORMACIÓN"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,0,0,10"/>

            <Border Background="{StaticResource Brush.Surface}"
                    CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Especialización"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding Dentist.Specialization}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Margin="0,2,0,12"/>

                    <TextBlock Text="Teléfono"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding Dentist.PhoneNumber}"
                               FontSize="14"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Margin="0,2,0,12"/>

                    <TextBlock Text="Correo"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding Dentist.Email}"
                               FontSize="14"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="RENDIMIENTO (ESTA SEMANA)"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,0,0,10"/>

            <Border Background="{StaticResource Brush.Surface}"
                    CornerRadius="12" Padding="18" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Citas esta semana"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding TotalAppointmentsThisWeek}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Brush.PrimaryPressed}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Brush.Surface}"
                    CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Procedimiento más frecuente"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding MostFrequentProcedureThisWeek}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right panel with weekly navigation and days -->
        <!-- Right panel with weekly navigation and days -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Navigation bar -->
                <RowDefinition Height="*"/>     <!-- Week days -->
            </Grid.RowDefinitions>

            <!-- Week navigation bar -->
            <Border Grid.Row="0" Padding="5" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Semana Anterior" 
                            Command="{Binding PreviousWeekCommand}" 
                            Margin="5,0"/>

                    <TextBlock Text="{Binding CurrentWeekRange}"
                               Margin="10,0"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Content="Semana Siguiente" 
                            Command="{Binding NextWeekCommand}" 
                            Margin="5,0"/>
                </StackPanel>
            </Border>

            <!-- Semana: Lun-Vie -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Helper: tarjeta de día reutilizable -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                        CornerRadius="10" Margin="0,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}"
                                CornerRadius="10,10,0,0" Padding="12,10">
                            <TextBlock Text="{Binding WeekDays[0].DisplayDate}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.PrimaryPressed}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding WeekDays[0].Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenAppointmentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                            <Border Background="{StaticResource Brush.Background}"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Border Background="{StaticResource Brush.Primary}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,6">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Patient.FullName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Treatment.Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding WeekDays[0].Appointments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin citas"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Brush.Surface}"
                        CornerRadius="10" Margin="5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}"
                                CornerRadius="10,10,0,0" Padding="12,10">
                            <TextBlock Text="{Binding WeekDays[1].DisplayDate}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.PrimaryPressed}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding WeekDays[1].Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenAppointmentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                            <Border Background="{StaticResource Brush.Background}"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Border Background="{StaticResource Brush.Primary}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,6">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Patient.FullName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Treatment.Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding WeekDays[1].Appointments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin citas" FontSize="12"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource Brush.Surface}"
                        CornerRadius="10" Margin="5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}"
                                CornerRadius="10,10,0,0" Padding="12,10">
                            <TextBlock Text="{Binding WeekDays[2].DisplayDate}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.PrimaryPressed}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding WeekDays[2].Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenAppointmentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                            <Border Background="{StaticResource Brush.Background}"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Border Background="{StaticResource Brush.Primary}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,6">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Patient.FullName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Treatment.Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding WeekDays[2].Appointments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin citas" FontSize="12"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource Brush.Surface}"
                        CornerRadius="10" Margin="5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}"
                                CornerRadius="10,10,0,0" Padding="12,10">
                            <TextBlock Text="{Binding WeekDays[3].DisplayDate}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.PrimaryPressed}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding WeekDays[3].Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenAppointmentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                            <Border Background="{StaticResource Brush.Background}"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Border Background="{StaticResource Brush.Primary}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,6">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Patient.FullName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Treatment.Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding WeekDays[3].Appointments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin citas" FontSize="12"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource Brush.Surface}"
                        CornerRadius="10" Margin="5,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}"
                                CornerRadius="10,10,0,0" Padding="12,10">
                            <TextBlock Text="{Binding WeekDays[4].DisplayDate}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.PrimaryPressed}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding WeekDays[4].Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenAppointmentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                            <Border Background="{StaticResource Brush.Background}"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Border Background="{StaticResource Brush.Primary}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,6">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Patient.FullName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Treatment.Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding WeekDays[4].Appointments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin citas" FontSize="12"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        <!-- OVERLAY: Detalles de la cita seleccionada -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#80000000"
              Panel.ZIndex="100"
              Visibility="{Binding HasSelectedAppointment, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource Brush.Surface}"
                    CornerRadius="14" Padding="0"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del overlay -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Primary}"
                            CornerRadius="14,14,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Detalles de la Cita"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="White"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CloseAppointmentDetailsCommand}"
                                    Width="30" Height="30"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Cerrar">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Contenido -->
                    <StackPanel Grid.Row="1" Margin="24">
                        <TextBlock Text="PACIENTE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedAppointment.Patient.FullName}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   Margin="0,2,0,16"/>

                        <TextBlock Text="TRATAMIENTO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedAppointment.Treatment.Name}"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   Margin="0,2,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FECHA" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAppointment.AppointmentDate, StringFormat=dd/MM/yyyy}"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="HORARIO" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock FontSize="14"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedAppointment.StartTime, StringFormat={}{0:hh\\:mm}}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding SelectedAppointment.EndTime, StringFormat={}{0:hh\\:mm}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="NOTAS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedAppointment.Notes}"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   MinHeight="40"/>
                    </StackPanel>

                    <!-- Footer con botón cerrar -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Background}"
                            CornerRadius="0,0,14,14"
                            Padding="20,14">
                        <Button Command="{Binding CloseAppointmentDetailsCommand}"
                                Style="{StaticResource Modern.Button.Primary}"
                                HorizontalAlignment="Right">
